    { "beatId": "intro", "narration": "Die Ableitung verrät dir, ob eine Funktion steigt oder fällt (Monotonie) und wo sie einen Hoch- oder Tiefpunkt hat (Extrempunkt)." },
    { "beatId": "why", "narration": "So findest du zum Beispiel den maximalen Gewinn oder den minimalen Materialverbrauch – ohne den ganzen Graphen zeichnen zu müssen." },
    { "beatId": "method", "narration": "An einem Extrempunkt ist die Ableitung gleich 0: f'(x) gleich 2x plus p gleich 0, also x gleich minus p halbe." },
    { "beatId": "example", "narration": "Für f(x) gleich x hoch 2 minus 4x plus 1 ist f'(x) gleich 2x minus 4. Nullsetzen ergibt x gleich 2 – den Extrempunkt." },
    { "beatId": "recap", "narration": "Zusammengefasst: Ableitung gleich 0 setzen und auflösen – das findet Extrempunkte." }
  ],
  "storyboard": [
