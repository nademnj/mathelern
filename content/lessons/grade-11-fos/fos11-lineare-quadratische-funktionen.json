  "script": [
    {
      "beatId": "intro",
      "narration": "Eine Funktion beschreibt, wie sich eine Größe verändert, wenn eine andere sich ändert – zum Beispiel, wie der Preis eines Produkts von der verkauften Menge abhängt."
    },
    {
      "beatId": "why",
      "narration": "Wenn du die Eigenschaften einer Funktion kennst – Steigung, Nullstellen, Scheitelpunkt – kannst du ihr Verhalten vorhersagen, ohne jeden einzelnen Punkt zu berechnen."
    },
    {
      "beatId": "linear_properties",
      "narration": "Eine lineare Funktion y = m·x + t hat zwei Kennzahlen: die Steigung m (wie steil die Gerade ist) und den y-Achsenabschnitt t (wo sie die y-Achse schneidet)."
    },
    {
      "beatId": "quadratic_properties",
      "narration": "Eine quadratische Funktion y = x² + px + q hat einen Scheitelpunkt – den höchsten oder tiefsten Punkt der Parabel. Seine x-Koordinate findest du mit x_s = -p/2."
    },
    {
      "beatId": "reallife",
      "narration": "Quadratische Funktionen beschreiben zum Beispiel die Flugbahn eines Balls oder den Gewinnverlauf eines Unternehmens – beide haben einen Höhepunkt, den Scheitelpunkt."
    }
  ],
