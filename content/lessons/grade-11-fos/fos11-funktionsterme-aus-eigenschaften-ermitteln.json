  "script": [
    { "beatId": "intro", "narration": "Kennst du die Nullstellen einer quadratischen Funktion, kannst du daraus die komplette Funktionsgleichung rekonstruieren." },
    { "beatId": "why", "narration": "Das ist nützlich, wenn du aus einer Beschreibung – zum Beispiel 'die Funktion hat Nullstellen bei 2 und 5' – die konkrete Formel bauen musst." },
    { "beatId": "method", "narration": "Der Ansatz: y gleich (x minus x1) mal (x minus x2), dann ausmultiplizieren, um Normalform zu erhalten." },
    { "beatId": "example", "narration": "Bei Nullstellen x1 gleich -2 und x2 gleich 3: y gleich (x+2)(x-3) gleich x hoch 2 minus x minus 6." },
    { "beatId": "recap", "narration": "Zusammengefasst: Aus den Nullstellen baust du den Funktionsterm als Produktform und multiplizierst aus." }
  ],
  "storyboard": [
    { "beatId": "beat-intro", "narrationRef": "intro", "component": "EquationStepReveal", "props": { "steps": [
      { "label": "Gegeben", "expression": "Nullstellen x₁, x₂" }
    ] } },
    { "beatId": "beat-why", "narrationRef": "why", "component": "EquationStepReveal", "props": { "steps": [
      { "label": "Anwendung", "expression": "Aus Beschreibung die Formel rekonstruieren" }
    ] } },
    { "beatId": "beat-method", "narrationRef": "method", "component": "EquationStepReveal", "props": { "steps": [
      { "label": "Ansatz", "expression": "y = (x - x₁)(x - x₂)" }
    ] } },
    { "beatId": "beat-example", "narrationRef": "example", "component": "EquationStepReveal", "props": { "steps": [
