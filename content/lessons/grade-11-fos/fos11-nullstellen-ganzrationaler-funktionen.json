  "script": [
    { "beatId": "intro", "narration": "Nullstellen sind die Stellen, an denen der Graph einer Funktion die x-Achse schneidet – dort ist y gleich 0." },
    { "beatId": "why", "narration": "Nullstellen verraten dir, wann ein Prozess startet oder endet – zum Beispiel, wann ein Gewinn bei null liegt." },
    { "beatId": "method", "narration": "Bei quadratischen Funktionen nutzt du die Mitternachtsformel: x gleich minus p plus/minus Wurzel aus (p hoch 2 minus 4q), geteilt durch 2." },
    { "beatId": "example", "narration": "Für x hoch 2 plus 3x minus 4 gleich 0 ergibt die Mitternachtsformel die Lösungen x1 gleich -4 und x2 gleich 1." },
    { "beatId": "recap", "narration": "Zusammengefasst: Nullstellen findest du, indem du die Funktionsgleichung gleich 0 setzt und auflöst." }
  ],
  "storyboard": [
