    { "beatId": "beat-why", "narrationRef": "why", "component": "EquationStepReveal", "props": { "steps": [
      { "label": "Anwendung", "expression": "Gewinnschwelle, Break-even-Punkt" }
    ] } },
    { "beatId": "beat-method", "narrationRef": "method", "component": "EquationStepReveal", "props": { "steps": [
      { "label": "Mitternachtsformel", "expression": "x = (-p ± √(p² - 4q)) / 2" }
