  "script": [
    {
      "beatId": "intro",
      "narration": "Stell dir vor, du verdoppelst eine Menge immer wieder: 2, 4, 8, 16... Statt 2·2·2·2 zu schreiben, schreiben wir kurz 2 hoch 4 – eine Potenz."
    },
    {
      "beatId": "why",
      "narration": "Potenzen sparen Schreibarbeit bei sehr großen Zahlen. 2 hoch 10 zu schreiben ist viel kürzer als zehnmal die 2 zu multiplizieren – und das Ergebnis ist 1024."
    },
    {
      "beatId": "product_rule",
      "narration": "Erstes Potenzgesetz: Multiplizierst du zwei Potenzen mit gleicher Basis, addierst du die Exponenten. a hoch m mal a hoch n ist a hoch (m+n)."
    },
    {
      "beatId": "negative_exponent",
      "narration": "Teilst du Potenzen mit gleicher Basis, subtrahierst du die Exponenten. Wird der Exponent dabei negativ, landest du im Nenner eines Bruchs: a hoch -n ist 1 durch a hoch n."
    },
    {
      "beatId": "reallife",
      "narration": "Das nutzt du ständig: Ein Gigabyte sind 2 hoch 30 Byte, und beim Zinseszins wächst dein Geld jedes Jahr um einen weiteren Faktor – das lernst du in der nächsten Lektion genauer."
    }
  ],
