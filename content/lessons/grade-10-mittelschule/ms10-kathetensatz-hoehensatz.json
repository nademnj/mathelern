    { "beatId": "intro", "narration": "In einem rechtwinkligen Dreieck teilt die Höhe auf die Hypotenuse diese in zwei Abschnitte p und q. Daraus ergeben sich zwei nützliche Sätze." },
    { "beatId": "why", "narration": "Diese Sätze helfen dir, fehlende Längen in rechtwinkligen Dreiecken zu berechnen, ohne den Satz des Pythagoras direkt zu benutzen." },
    { "beatId": "hoehensatz", "narration": "Der Höhensatz: Die Höhe zum Quadrat ist gleich p mal q – das Produkt der beiden Hypotenusenabschnitte." },
    { "beatId": "example", "narration": "Bei p = 4 cm und q = 9 cm ist h hoch 2 gleich 36, also h gleich 6 cm." },
    { "beatId": "recap", "narration": "Zusammengefasst: Der Höhensatz verbindet die Höhe eines rechtwinkligen Dreiecks mit den beiden Hypotenusenabschnitten." }
  ],
  "storyboard": [
