  "script": [
    { "beatId": "intro", "narration": "Bei linearem Wachstum kommt jedes Mal derselbe Betrag dazu. Bei exponentiellem Wachstum wird jedes Mal mit demselben Faktor multipliziert – das geht viel schneller." },
    { "beatId": "why", "narration": "Zinseszins, Bevölkerungswachstum, radioaktiver Zerfall – überall, wo sich etwas um einen Prozentsatz verändert, wächst oder schrumpft es exponentiell." },
    { "beatId": "formula", "narration": "Die Formel: Endwert = Startwert mal Wachstumsfaktor hoch Anzahl der Zeiträume." },
    { "beatId": "example", "narration": "Eine Bakterienkultur mit 20 Bakterien verdoppelt sich jede Stunde. Nach 3 Stunden sind es 20 mal 2 hoch 3, also 160 Bakterien." },
    { "beatId": "recap", "narration": "Zusammengefasst: Exponentielles Wachstum multipliziert statt zu addieren – kleine Unterschiede im Faktor machen auf lange Sicht einen riesigen Unterschied." }
  ],
