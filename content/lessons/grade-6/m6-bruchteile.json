  "script": [
    {
      "beatId": "intro",
      "narration": "Du teilst eine Pizza mit Freunden. Sie wird in 8 Stücke geschnitten, und du nimmst dir 3 davon. Das ist ein Bruchteil: 3 von 8 Stücken."
    },
    {
      "beatId": "why",
      "narration": "Nicht alles lässt sich in ganzen Zahlen ausdrücken. Ein halber Kuchen und zwei Viertel sind gleich groß – Brüche helfen uns, solche Teile genau zu beschreiben."
    },
    {
      "beatId": "naming",
      "narration": "Ein Bruch hat zwei Teile: oben steht der Zähler (wie viele Teile du hast), unten der Nenner (in wie viele Teile das Ganze geteilt wurde)."
    },
    {
      "beatId": "reallife",
      "narration": "Rezepte nutzen Brüche ständig: 3/4 Liter Milch oder 1/2 Teelöffel Salz. Wer Brüche versteht, kann genau nach Rezept kochen."
    },
    {
      "beatId": "recap",
      "narration": "Zusammengefasst: Ein Bruch beschreibt einen Teil eines Ganzen – Zähler oben, Nenner unten. So kannst du Mengen genau aufteilen."
    }
  ],
