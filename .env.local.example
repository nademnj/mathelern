# Copy to .env.local and fill in from your Supabase project settings (EU/Frankfurt region).
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only, never exposed to the browser - used by scripts/sync-content.ts and the
# recommendation rule engine, which must bypass RLS to write on a student's behalf.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
